# Used by the backend to generate links in emails to the frontend, and always
# allowed as a CORS origin. Also injected into the landing page container.
FRONTEND_HOST=http://localhost:5173
# In staging and production, set this env var to the Cloudflare-hosted frontend:
# FRONTEND_HOST=https://app.staging.shop-n-cook.com   # staging
# FRONTEND_HOST=https://app.shop-n-cook.com           # production

# Environment: local, staging, production
ENVIRONMENT=local

PROJECT_NAME="Shop'n'Cook"

# Backend
BACKEND_CORS_ORIGINS="http://localhost,http://localhost:5173,https://localhost,https://localhost:5173"
SECRET_KEY=changethis
FIRST_SUPERUSER=admin@example.com
FIRST_SUPERUSER_PASSWORD=changethis

# Emails
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=
EMAILS_FROM_EMAIL=info@example.com
SMTP_TLS=True
SMTP_SSL=False
SMTP_PORT=587

# Postgres
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=app
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changethis

SENTRY_DSN=

# URL of the backend API — used at build time by Vite (frontend) and the extension.
# In staging:    API_URL=https://api.staging.shop-n-cook.com
# In production: API_URL=https://api.shop-n-cook.com
# The Cloudflare Workers builds read this from frontend/.env.{staging,production}
# as VITE_API_URL instead — see deployment.md.
API_URL=http://localhost:8000

# AI Recipe Import
# Set AI_PROVIDER to: anthropic | openai | google
AI_PROVIDER=anthropic

# Anthropic (https://console.anthropic.com)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Google Gemini (https://aistudio.google.com)
GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-2.5-flash

# OpenAI (https://platform.openai.com)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Spoonacular ingredient images (https://spoonacular.com/food-api)
SPOONACULAR_API_KEY=

# LangSmith observability (optional — https://smith.langchain.com)
LANGCHAIN_TRACING_V2=false
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT="Shop'n'cook - dev"

# Rate limiting (set to True in production to protect auth endpoints)
RATE_LIMIT_ENABLED=False

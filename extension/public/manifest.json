{
  "manifest_version": 3,
  "name": "Shop'n'Cook",
  "version": "1.0.0",
  "description": "Import recipes into Shop'n'Cook with one click",
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "extension@shop-n-cook.com",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"],
        "optional": []
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  },
  "permissions": ["activeTab", "storage"],
  "host_permissions": ["<all_urls>"]
}

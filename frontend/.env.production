# Loaded by `vite build --mode production` (and by a plain `vite build`),
# on top of frontend/.env.
# Public values only — never put secrets in a VITE_* variable, they are
# inlined into the client bundle.
#
# Inline environment variables still win over this file, so the Docker image
# build (`--build-arg VITE_API_URL=...`) keeps overriding these defaults.
VITE_API_URL=https://api.shop-n-cook.com
VITE_PROJECT_NAME="Shop'n'Cook"

{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "shop-n-cook-landing",
  "compatibility_date": "2026-08-01",
  // Pure static site — no Worker script. The default `html_handling`
  // ("auto-trailing-slash") serves /privacy from privacy.html, matching the
  // `try_files $uri $uri.html` rule in landing/nginx.conf.
  "assets": {
    "directory": "./dist"
  },
  // No `routes` key — the custom domains are attached by hand in the Cloudflare
  // dashboard. See the matching comment in frontend/wrangler.jsonc for why, and
  // deployment.md for the bindings themselves.
  "workers_dev": false,
  "env": {
    "staging": {
      "name": "shop-n-cook-landing-staging",
      // Repeated rather than inherited so `deploy --dry-run --env staging`
      // catches an environment that resolves to no assets.
      "assets": {
        "directory": "./dist"
      }
    },
    "production": {
      "name": "shop-n-cook-landing",
      "assets": {
        "directory": "./dist"
      }
    }
  }
}
